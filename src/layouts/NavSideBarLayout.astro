---
interface Props {
	title: string
}
import { getLangFromUrl } from '../i18n/utils'
import { ClientRouter } from 'astro:transitions'

import '../styles/index.css'
import NavSideBar from '@components/NavSideBar.astro'
import '@fontsource-variable/roboto'
import '@fontsource-variable/inter'

const { title } = Astro.props
const lang = getLangFromUrl(Astro.url)
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Astro description" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/tmp-favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
		<title>{title}</title>
		<ClientRouter />
	</head>
	<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-G0B00QVBJ8"></script>
<script>
	//@ts-ignore
  window.dataLayer = window.dataLayer || [];
	//@ts-ignore

  function gtag(){dataLayer.push(arguments);}
	//@ts-ignore

  gtag('js', new Date());
	//@ts-ignore

  gtag('config', 'G-G0B00QVBJ8');
</script>
	<body class="min-h-dvh bg-c-black">
		<!-- <body class="min-h-dvh bg-gradient-to-b from-c-neutral-900 to-c-neutral-800"> -->
		<NavSideBar />
		<div class="ml-0 flex lg:ml-72">
			<slot />
		</div>
		<!-- <footer class="flex bg-slate-400 w-dvw h-fit"></footer> -->
		<script>
			import gsap from 'gsap'
			// @ts-ignore
			window.gsap = gsap
		</script>
	</body>
</html>
<style is:global>
	:root {
		--neutral-cool-grey-1: 210 25 7;
		--neutral-cool-grey-2: 210 12 15;
		--navbar-height: 50px;
		--navbar-offset: calc(-1 * var(--navbar-height));
	}
	@font-face {
		font-family: 'Open Sans';
		font-style: normal;
		font-weight: 400;
		font-display: swap;
		src: url(/fonts/OpenSans-VariableFont_wdth,wght.ttf) format('truetype');
	}

	body {
		/* max-width: 100dvw;
    min-height: 100dvh; */
		height: 100%;
		overflow-x: hidden;
		/* overflow: hidden; */
	}
</style>
