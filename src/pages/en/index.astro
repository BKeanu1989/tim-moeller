---
import { Picture, Image } from 'astro:assets'

import NavSideBarLayout from 'src/layouts/NavSideBarLayout.astro'
import HeroImage from "@assets/mountains.jpg";
import MyButton from '@components/buttons/MyButton.astro';
// import tim from '@assets/tim-j-moeller-bigger.png'
import tim from '@assets/dr-tim-julian-moeller-portrait.png'

import { getLangFromUrl, useTranslations } from 'src/i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const contactLink = `/${lang}/contact`;
const mailtoLink = `mailto:praxis@timjmoeller.com?subject=${encodeURIComponent(t('home.contact.mail_subject'))}`;
---

<NavSideBarLayout title="Dr. Tim Julian Möller">

<main id="home" class="w-full">

<!-- ============ HERO ============ -->
<section class="hero relative h-dvh p-0 h-" id="hero">
  <div class="hero-bg absolute -z-10">
	<div class="bg bg-black/70 absolute w-full h-full"></div>
	<div class="hero-image-container h-dvh ">
		<Picture priority  src={HeroImage} widths={[360, 720, 1400, 1920]} sizes={`(max-width: 400px) 360px, (max-width: 800px) 720px, (max-width: 1400px) 1400px, 1920px`} class={"-z-20 max-h-dvh hidden lg:block"} alt={t('home.hero.image_alt')}></Picture>

	</div>
  </div>
  <!-- <div class="hero-veil"></div> -->
  <div class="wrap hero-inner flex flex-col lg:min-w-[700px] lg:w-1/2 mx-auto justify-center h-dvh">
    <span class="eyebrow section-title text-c-accent font-bold">{t('home.hero.eyebrow')}</span>
    <h1 set:html={t('home.hero.title')}></h1>
    <p class="text-c-muted-grey-light">{t('home.hero.text')}</p>
    <div class="hero-ctas">
		<MyButton type='primary' href='#kontakt'>
			{t('home.cta.request_consultation')}
        <svg class="inline" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>

		</MyButton>
    </div>
    <div class="hero-badges">
      <span class="badge"><svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg>{t('home.hero.badge1')}</span>
      <span class="badge"><svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.6 3.8 5.7 3.8 9S14.5 18.4 12 21c-2.5-2.6-3.8-5.7-3.8-9S9.5 5.6 12 3z"/></svg>{t('home.hero.badge2')}</span>
      <span class="badge"><svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M20 6L9 17l-5-5"/></svg>{t('home.hero.badge3')}</span>
    </div>
  </div>
  <div class="scroll-hint"><svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M6 9l6 6 6-6"/></svg></div>
</section>

<!-- ============ STATEMENT ============ -->
<section class="statement">
  <div class="wrap">
    <p class="reveal">{t('home.statement.quote')}</p>
    <p class="src reveal">{t('home.statement.source')}</p>
  </div>
</section>

<!-- ============ LEISTUNGEN ============ -->
<section id="leistungen">
  <div class="wrap">
    <span class="section-title ">{t('home.services.eyebrow')}</span>
    <h2 class="reveal text-4xl tracking-wide" set:html={t('home.services.title')}></h2>
    <p class="section-lead reveal">{t('home.services.lead1')}</p>
    <p class="section-lead reveal" style="margin-top:1.2rem">{t('home.services.lead2')}</p>

    <div class="tiles">
      <div class="tile reveal">
        <div class="tile-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M20 13.5A8.5 8.5 0 1 1 10.5 4 7 7 0 0 0 20 13.5z"/></svg></div>
        <h3>{t('home.card1.title')}</h3>
        <p>{t('home.card1.text')}</p>
      </div>
      <div class="tile reveal">
        <div class="tile-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M3 12h4l2-6 4 12 2-6h6"/></svg></div>
        <h3>{t('home.card2.title')}</h3>
        <p>{t('home.card2.text')}</p>
      </div>
      <div class="tile reveal">
        <div class="tile-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M12 3l7 3v5c0 4.6-3 8.4-7 10-4-1.6-7-5.4-7-10V6l7-3z"/></svg></div>
        <h3>{t('home.card3.title')}</h3>
        <p>{t('home.card3.text')}</p>
      </div>
      <div class="tile reveal">
        <div class="tile-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg></div>
        <h3>{t('home.card4.title')}</h3>
        <p>{t('home.card4.text')}</p>
      </div>
    </div>

    <div class="note reveal" set:html={t('home.services.note')}></div>
  </div>
</section>

<!-- ============ WARUM PSYCHOTHERAPIE ============ -->
<section id="warum" style="background:var(--bg-2);border-top:1px solid var(--line);border-bottom:1px solid var(--line)">
  <div class="wrap split">
    <div class="sticky reveal">
      <span class="section-title">{t('home.why.eyebrow')}</span>
      <h2>{t('home.why.title')}</h2>
      <p>{t('home.why.text')}</p>
	  <MyButton class='mt-5' href='#kontakt'>{t('home.cta.request_consultation')}</MyButton>
    </div>
    <div>
      <p class="reveal">{t('home.why.p1')}</p>
      <p class="reveal" set:html={t('home.why.p2')}></p>
      <p class="reveal">{t('home.why.p3')}</p>
      <p class="reveal">{t('home.why.p4')}</p>
      <p class="reveal">{t('home.why.p5')}</p>
    </div>
  </div>
</section>
<!-- ============ VERHALTENSTHERAPIE ============ -->
<section id="verhaltenstherapie">
  <div class="wrap split">
    <div>
      <span class="section-title">{t('home.cbt.eyebrow')}</span>
      <h2 class="reveal">{t('home.cbt.title')}</h2>
      <p class="reveal">{t('home.cbt.p1')}</p>
      <p class="reveal" set:html={t('home.cbt.p2')}></p>
      <p class="reveal">{t('home.cbt.p3')}</p>
      <p class="reveal">{t('home.cbt.p4')}</p>
    </div>
    <div style="margin-top:2.6rem">
      <div class="sub-block reveal">
        <h3>{t('home.cbt.why.title')}</h3>
        <p>{t('home.cbt.why.p1')}</p>
        <p style="margin-top:.8rem">{t('home.cbt.why.p2')}</p>
        <p style="margin-top:.8rem">{t('home.cbt.why.p3')}</p>
      </div>
      <div class="sub-block reveal">
        <h3>{t('home.cbt.practice.title')}</h3>
        <p>{t('home.cbt.practice.p1')}</p>
        <p style="margin-top:.8rem">{t('home.cbt.practice.p2')}</p>
        <p style="margin-top:.8rem">{t('home.cbt.practice.p3')}</p>
      </div>
    </div>
  </div>
</section>

<!-- ============ ABLAUF ============ -->
<section id="ablauf" style="background:var(--bg-2);border-top:1px solid var(--line);border-bottom:1px solid var(--line)">
  <div class="wrap split">
    <div class="sticky reveal">
      <span class="section-title">{t('home.process.eyebrow')}</span>
      <h2>{t('home.process.title')}</h2>
      <p>{t('home.process.text')}</p>
      <ul class="check-list">
        <li>{t('home.process.check1')}</li>
        <li>{t('home.process.check2')}</li>
        <li>{t('home.process.check3')}</li>
        <li>{t('home.process.check4')}</li>
      </ul>
      <p style="font-size:.9rem;margin-top:1.4rem">{t('home.process.tech')}</p>
    </div>
    <div class="steps">
      <div class="step reveal">
        <div class="step-num"></div>
        <div>
          <h3>{t('home.step1.title')}</h3>
          <p>{t('home.step1.text')}</p>
          <span class="tag">{t('home.step1.tag')}</span>
        </div>
      </div>
      <div class="step reveal">
        <div class="step-num"></div>
        <div>
          <h3>{t('home.step2.title')}</h3>
          <p>{t('home.step2.text')}</p>
          <span class="tag">{t('home.step2.tag')}</span>
        </div>
      </div>
      <div class="step reveal">
        <div class="step-num"></div>
        <div>
          <h3>{t('home.step3.title')}</h3>
          <p>{t('home.step3.text')}</p>
          <span class="tag">{t('home.step3.tag')}</span>
        </div>
      </div>
      <div class="step reveal">
        <div class="step-num"></div>
        <div>
          <h3>{t('home.step4.title')}</h3>
          <p>{t('home.step4.text')}</p>
          <span class="tag">{t('home.step4.tag')}</span>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ============ KOSTEN ============ -->
<section id="kosten">
  <div class="wrap">
    <span class="section-title">{t('home.costs.eyebrow')}</span>
    <h2 class="reveal">{t('home.costs.title')}</h2>
    <p class="section-lead reveal">{t('home.costs.lead')}</p>

    <div class="price-cards">
      <div class="price-card featured reveal">
        <span class="free-tag">{t('home.price1.tag')}</span>
        <h3>{t('home.price1.title')}</h3>
        <div class="price-big">{t('home.price1.price')}</div>
        <div class="price-sub">{t('home.price1.sub')}</div>
        <p>{t('home.price1.text')}</p>
      </div>
      <div class="price-card reveal">
        <span class="free-tag" style="background:rgba(138,184,172,.14);color:var(--teal)">{t('home.price2.tag')}</span>
        <h3>{t('home.price2.title')}</h3>
        <div class="price-big">{t('home.price2.price')}</div>
        <div class="price-sub">{t('home.price2.sub')}</div>
        <p>{t('home.price2.text')}</p>
      </div>
      <div class="price-card reveal">
        <span class="free-tag" style="background:rgba(138,184,172,.14);color:var(--teal)">{t('home.price3.tag')}</span>
        <h3>{t('home.price3.title')}</h3>
        <div class="price-big" style="font-size:1.6rem;padding-top:.9rem">{t('home.price3.price')}</div>
        <div class="price-sub">{t('home.price3.sub')}</div>
        <p>{t('home.price3.text')}</p>
      </div>
    </div>

    <div class="note reveal" set:html={t('home.costs.note')}></div>
  </div>
</section>
<!-- ============ ÜBER MICH ============ -->
<section id="ueber-mich" style="background:var(--bg-2);border-top:1px solid var(--line);border-bottom:1px solid var(--line)">
  <div class="wrap about-grid">
    <div class="portrait reveal relative">
      <Image src={tim} class={"absolute left-0 top-0 z-10"} alt={t('home.about.image_alt')}></Image>
      <div class="portrait-bg"></div>
      <span class="z-20">Tim Julian Möller<small>{t('home.about.portrait_subtitle')}</small></span>

    </div>
    <div class="flex flex-col">
      <span class="eyebrow section-title">{t('home.about.eyebrow')}</span>
      <h2 class="reveal">{t('home.about.title')}</h2>
      <!-- HINWEIS: Qualifikation bitte anpassen (z. B. „approbierter Psychotherapeut" oder „Psychotherapeut in Ausbildung unter Supervision") -->
      <p class="reveal">{t('home.about.p1')}</p>
      <p class="reveal">{t('home.about.p2')}</p>
      <p class="reveal">{t('home.about.p3')}</p>
      <p class="reveal" set:html={t('home.about.p4')}></p>
	    <MyButton class="mt-5 reveal" type='tertiary' href="#kontakt">{t('home.about.button')}</MyButton>
    </div>
  </div>
</section>

<!-- ============ FAQ ============ -->
<section id="faq">
  <div class="wrap">
    <div style="text-align:center">
      <span class="eyebrow section-title">{t('home.faq.eyebrow')}</span>
      <h2 class="reveal">{t('home.faq.title')}</h2>
    </div>
    <div class="faq">
      <details class="reveal" open>
        <summary>{t('home.faq1.q')}<span class="plus"></span></summary>
        <div class="answer"><p>{t('home.faq1.a')}</p></div>
      </details>
      <details class="reveal">
        <summary>{t('home.faq2.q')}<span class="plus"></span></summary>
        <div class="answer"><p>{t('home.faq2.a')}</p></div>
      </details>
      <details class="reveal">
        <summary>{t('home.faq3.q')}<span class="plus"></span></summary>
        <div class="answer"><p>{t('home.faq3.a')}</p></div>
      </details>
      <details class="reveal">
        <summary>{t('home.faq4.q')}<span class="plus"></span></summary>
        <div class="answer"><p>{t('home.faq4.a')}</p></div>
      </details>
      <details class="reveal">
        <summary>{t('home.faq5.q')}<span class="plus"></span></summary>
        <div class="answer"><p>{t('home.faq5.a')}</p></div>
      </details>
    </div>
  </div>
</section>

<!-- ============ CTA / KONTAKT ============ -->
<section id="kontakt" style="padding-top:20px">
  <div class="wrap">
    <div class="cta-banner reveal">
      <div class="bg -z-10"></div>
      <div class="veil"></div>
      <div>
        <span class="eyebrow section-title">{t('home.contact.eyebrow')}</span>
        <h2>{t('home.contact.title')}</h2>
        <p>{t('home.contact.text')}</p>
        <div class="cta-buttons flex gap-5 justify-center mt-5">
          <MyButton type='tertiary' href={mailtoLink}>
            {t('home.cta.request_consultation')}
                <svg class="inline" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </MyButton>
          <MyButton type='primary' href={contactLink}>
            {t('home.contact.form_button')}
                <svg class="inline" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </MyButton>
        </div>

        <p style="margin-top:1.6rem;font-size:.88rem;color:var(--muted)">praxis@timjmoeller.com · {t('home.contact.reply_note')}</p>
      </div>
    </div>
  </div>
</section>

</main>

<style>
	svg {
		@apply h-5 w-5;
	}
</style>

<script>
	document.addEventListener("astro:page-load", () => {
  (function() {
    const chips = document.querySelectorAll('.filter-chip');
    const cards = document.querySelectorAll('.card');

    chips.forEach(chip => {
      chip.addEventListener('click', () => {
        chips.forEach(c => c.setAttribute('aria-pressed', 'false'));
        chip.setAttribute('aria-pressed', 'true');

        // @ts-ignore
        const f = chip.dataset.filter;
        if (!f) {
          console.warn("no filter found")
        }
        cards.forEach(card => {
        // @ts-ignore
          const show = f === 'alle' || card.dataset.tags.split(' ').includes(f);
          card.classList.toggle('hidden', !show);
        });
      });
    });
  })()
})
</script>
</NavSideBarLayout>
