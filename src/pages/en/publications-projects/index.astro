---
import NavSideBarLayout from '../../../layouts/NavSideBarLayout.astro'

import { getCollection } from 'astro:content'
import Publication from '@components/Publication.astro'
import { getLangFromUrl, useTranslations } from 'src/i18n/utils'

const allPublications = await getCollection('publications')
console.log('🚀 ~ allPublications:', allPublications)

const englishPublications = allPublications.filter((x) => x.slug.includes('en/'))

englishPublications.sort((a, b) => {
	if (a.data.year > b.data.year) {
		return -1
	} else if (a.data.year < b.data.year) {
		return 1
	}

	return 0
})


const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

---

<NavSideBarLayout title={t('misc.projects_publications')}>
	<main class="w-full text-white" id="publications">

	<header class="page-head">
		<p class="eyebrow">Forschung &amp; Entwicklung</p>
		<h1>{t('misc.projects_publications')}</h1>
		<p class="lede">
			Eine Übersicht unserer aktuellen Projekte, veröffentlichten Arbeiten und
			offenen Beiträge. Jeder Eintrag verlinkt auf den vollständigen Beitrag
			bzw. das zugehörige Repository.
		</p>
	</header>

  <nav class="filters" aria-label="Nach Kategorie filtern">
    <button class="filter-chip" data-filter="alle" aria-pressed="true">Alle</button>
    <button class="filter-chip" data-filter="projekt" aria-pressed="false">Projekt</button>
    <button class="filter-chip" data-filter="publikation" aria-pressed="false">Publikation</button>
    <button class="filter-chip" data-filter="open-source" aria-pressed="false">Open Source</button>
    <button class="filter-chip" data-filter="preprint" aria-pressed="false">Preprint</button>
  </nav>
		<div class="flex flex-col flex-wrap place-content-evenly gap-5 md:flex-row">
			{
				englishPublications.map((x) => {
					return (
						<div class="single-publication mx-auto w-[90lvw] rounded-sm md:w-2/5">
							<Publication class:list={'h-full'} input={x} />
						</div>
					)
				})
			}
		</div>
	</main>
</NavSideBarLayout>
