---
import NavSideBarLayout from '../../layouts/NavSideBarLayout.astro'
import Education from "@components/icons/education.astro"
import ECG from "@assets/ecg.svg"
import Raspberry from "@assets/raspberry-pi.svg"
import Therapy from '@assets/therapy.svg'

import { getLangFromUrl, useTranslations } from "src/i18n/utils";
import CareerIndex from '@components/CareerIndex.astro'
import  { Picture } from 'astro:assets'
import HeroImage from '@assets/bessi-new-year-background-736885_1920.jpg'
import TimeLine from '@components/TimeLine.astro'

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<NavSideBarLayout title="About me">
    <main id="about-me" class="w-full">

    <section class="hero atf h-dvh">
        <div class="hero-bg absolute -z-10">
        <div class="bg bg-black/70 absolute w-full h-full"></div>
        <div class="hero-image-container h-dvh ">
            <Picture priority  src={HeroImage} widths={[360, 720, 1400, 1920]} sizes={`(max-width: 400px) 360px, (max-width: 800px) 720px, (max-width: 1400px) 1400px, 1920px`} class={"-z-20 max-h-dvh hidden lg:block"} alt="Berglandschaft"></Picture>

        </div>
  </div>
      <div class="wrap flex flex-col justify-center h-full">
        <span class="eyebrow section-title">Über mich</span>
        <h1>Therapie, die <em class="text-c-accent">Forschung</em> ernst nimmt – und Sie noch viel mehr.</h1>
        <p class="lead text-c-muted-grey">
          Psychotherapeut in Ausbildung unter Supervision? Nein – kognitive Verhaltenstherapie,
          online, auf Deutsch und Englisch: wissenschaftlich fundiert, transparent und gemeinsam vereinbart.
        </p>
        <div class="hero-meta">
          <span class="chip gold"><span class="dot"></span>Kognitive Verhaltenstherapie</span>
          <span class="chip gold"><span class="dot"></span>Online-Praxis</span>
          <span class="chip"><span class="dot"></span>Deutsch &amp; Englisch</span>
          <span class="chip"><span class="dot"></span>Forschung &amp; Lehre</span>
        </div>
      </div>
    </section>
    
    <!-- ================= HALTUNG ================= -->
    <section id="haltung">
      <div class="wrap">
        <div class="section-head">
          <span class="eyebrow">Meine Haltung</span>
          <h2>Gemeinsam statt vorgefertigt</h2>
        </div>
    
        <div class="belief-grid flex items-start">
          <div class="belief-text">
            <p>
              Ich bin Psychotherapeut und arbeite im Verfahren der kognitiven Verhaltenstherapie.
              In meiner Privatpraxis behandle ich Erwachsene ausschließlich online – auf Deutsch und Englisch.
            </p>
            <p>
              Meine Haltung ist es, Ihre persönlichen Erfahrungen ernst zu nehmen und mit einem
              wissenschaftlich fundierten therapeutischen Vorgehen zu verbinden.
              <strong>Sie sind die Expertin oder der Experte für Ihr Leben;</strong>
              ich bringe methodisches Wissen und Erfahrung im therapeutischen Prozess ein.
              Zusammen entwickeln wir Verständnis für Ihre Situation und konkrete Wege,
              die zu Ihrem Alltag passen.
            </p>
            <p>
              Mir ist wichtig, dass Sie jederzeit nachvollziehen können, wohin wir gehen:
              Wir vereinbaren Ziele gemeinsam, überprüfen regelmäßig unsere Fortschritte und
              passen die Behandlung an, wenn etwas nicht hilfreich ist.
              <strong>Ihre Rückmeldungen sind ausdrücklich Teil des Prozesses – auch wenn sie kritisch sind.</strong>
            </p>
            <p>
              Neben meiner therapeutischen Tätigkeit bin ich in Forschung und Lehre tätig.
              Dieser Hintergrund prägt meine Arbeit: Ich orientiere mich an gut untersuchten
              Methoden und daran, was für Ihre Situation tatsächlich hilfreich ist.
            </p>
          </div>
    
          <aside class="quote-card sticky">
            <blockquote>
              Sie sind die Expertin oder der Experte für Ihr Leben.
            </blockquote>
            <cite>— Grundsatz meiner Arbeit</cite>
          </aside>
        </div>
      </div>
    </section>
    
    <!-- ================= AFFILIATIONS ================= -->
    <section id="affiliations">
      <div class="wrap">
        <div class="section-head">
          <span class="eyebrow">Affiliations &amp; Contributions</span>
          <h2>Forschung, Lehre &amp; Praxis</h2>
          <p>Ein Überblick über die Institutionen und Projekte, mit denen ich verbunden bin – von der Grundlagenforschung bis zur Psychotherapieausbildung.</p>
        </div>
    
