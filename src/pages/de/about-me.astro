---
import NavSideBarLayout from '../../layouts/NavSideBarLayout.astro'
import Education from "@components/icons/education.astro"
import ECG from "@assets/ecg.svg"
import Raspberry from "@assets/raspberry-pi.svg"
import Therapy from '@assets/therapy.svg'

import { getLangFromUrl, useTranslations } from "src/i18n/utils";
import CareerIndex from '@components/CareerIndex.astro'
import  { Picture } from 'astro:assets'
import HeroImage from '@assets/bessi-new-year-background-736885_1920.jpg'
import TimeLine from '@components/TimeLine.astro'

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<NavSideBarLayout title={t('nav.about')}>
    <main id="about-me" class="w-full">

    <section class="hero atf h-dvh">
        <div class="hero-bg absolute -z-10">
        <div class="bg bg-black/70 absolute w-full h-full"></div>
        <div class="hero-image-container h-dvh ">
            <Picture priority  src={HeroImage} widths={[360, 720, 1400, 1920]} sizes={`(max-width: 400px) 360px, (max-width: 800px) 720px, (max-width: 1400px) 1400px, 1920px`} class={"-z-20 max-h-dvh hidden lg:block"} alt={t('aboutme.hero.image_alt')}></Picture>

        </div>
  </div>
      <div class="wrap flex flex-col mx-auto justify-center h-full">
        <span class="eyebrow section-title">{t('aboutme.hero.eyebrow')}</span>
        <h1 set:html={t('aboutme.hero.title')}></h1>
        <p class="lead text-c-muted-grey">{t('aboutme.hero.lead')}</p>
        <div class="hero-meta">
          <span class="chip gold"><span class="dot"></span>{t('aboutme.hero.chip1')}</span>
          <span class="chip gold"><span class="dot"></span>{t('aboutme.hero.chip2')}</span>
          <span class="chip"><span class="dot"></span>{t('aboutme.hero.chip3')}</span>
          <span class="chip"><span class="dot"></span>{t('aboutme.hero.chip4')}</span>
        </div>
      </div>
    </section>

    <!-- ================= HALTUNG ================= -->
    <section id="haltung">
      <div class="wrap reveal">
        <div class="section-head">
          <span class="eyebrow section-title">{t('aboutme.stance.eyebrow')}</span>
          <h2>{t('aboutme.stance.title')}</h2>
        </div>

        <div class="belief-grid flex items-start">
          <div class="belief-text">
            <p>{t('aboutme.stance.p1')}</p>
            <p set:html={t('aboutme.stance.p2')}></p>
            <p set:html={t('aboutme.stance.p3')}></p>
            <p>{t('aboutme.stance.p4')}</p>
          </div>

          <aside class="quote-card sticky">
            <blockquote>{t('aboutme.stance.quote')}</blockquote>
            <cite>{t('aboutme.stance.cite')}</cite>
          </aside>
        </div>
      </div>
    </section>

    <!-- ================= AFFILIATIONS ================= -->
    <section id="affiliations">
      <div class="wrap">
        <div class="section-head">
          <span class="eyebrow section-title">{t('aboutme.affiliations.eyebrow')}</span>
          <h2>{t('aboutme.affiliations.title')}</h2>
          <p>{t('aboutme.affiliations.text')}</p>
        </div>
        <TimeLine lang={lang} />
      </div>
    </section>
    
    <!-- ================= OPEN SOURCE ================= -->
    <section id="opensource">
      <div class="wrap">
        <div class="oss cta-banner reveal">
          <span class="section-title">{t('aboutme.oss.eyebrow')}</span>
          <h2>{t('aboutme.oss.title')}</h2>
          <p set:html={t('aboutme.oss.p1')}></p>
          <p set:html={t('aboutme.oss.p2')}></p>
          <div class="tags">
            <span class="tag">Open Source</span>
            <span class="tag">Real-Time ECG</span>
            <span class="tag">Low-Budget Hardware</span>
            <span class="tag">Signal Processing</span>
            <span class="tag">EEG &amp; Eye-Tracking</span>
          </div>
        </div>
      </div>
    </section>
</main>
</NavSideBarLayout>

<style>
  @reference "../../main.css";

    .business-card {
		background: linear-gradient(135deg, #000 20%, #131313 50%, #000 80%);
		transition-duration: 300ms;
		transition-property: transform, box-shadow;
		transition-timing-function: ease-out;
	}

	.business-card:hover {
		box-shadow: 0 1px 2px 2px #eee;
	}

    .opensource-subtitle, .education-subtitle, .therapy-subtitle {
        /* color: @apply text-; */
        @apply text-blue-500;
    }



/* ---------- Responsive ---------- */
@media (max-width: 860px){
  .belief-grid{ flex-direction: column; }
  .quote-card{
     position:static; order: 1; margin-bottom: 24px; 
    }
  .belief-text{ order: 2; }
  .oss{ padding:36px 26px; }
}
@media (max-width: 560px){
  .t-card{ grid-template-columns:1fr; }
  .hero{ padding:64px 0 48px; }
  section{ padding:44px 0; }
}
</style>

<script>
	
</script>
