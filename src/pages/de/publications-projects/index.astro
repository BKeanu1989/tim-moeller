---
import NavSideBarLayout from '../../../layouts/NavSideBarLayout.astro'

import { getCollection } from 'astro:content'
import Publication from '@components/Publication.astro'
import { getLangFromUrl, useTranslations, slugify, endSlugify } from 'src/i18n/utils'

const allPublications = await getCollection('publications')
console.log('🚀 ~ allPublications:', allPublications)

const englishPublications = allPublications.filter((x) => x.slug.includes('en/'))

englishPublications.sort((a, b) => {
	if (a.data.year > b.data.year) {
		return -1
	} else if (a.data.year < b.data.year) {
		return 1
	}

	return 0
})


const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const allTags = ()=> {
	  const tagsSet = new Set<string>();
  englishPublications.forEach((pub) => {
	// pub.data.
	if (!pub.data.tags) return;
	pub.data.tags.forEach((tag) => tagsSet.add(tag));
  });
  return Array.from(tagsSet);
}

---

<NavSideBarLayout title={t('misc.projects_publications')}>
	<main class="w-full text-white page " id="publications">

	<header class="page-head">
		<p class="eyebrow section-title">{t('publications.eyebrow')}</p>
		<h1>{t('misc.projects_publications')}</h1>
		<p class="lede">{t('publications.lede')}</p>
	</header>

	<nav class="filters" aria-label={t('publications.filter_label')}>
	  <button class="filter-chip" data-filter="alle" aria-pressed="true">{t('publications.filter_all')}</button>
	{
		allTags ? allTags().map((tag) => (
			<button class="filter-chip" data-filter={slugify(tag)} aria-pressed="false">{endSlugify(tag)}</button>
		)) : null
	}
    <button class="filter-chip" data-filter="publication" aria-pressed="false">{t('publications.filter_publication')}</button>
    <!-- <button class="filter-chip" data-filter="projekt" aria-pressed="false">Projekt</button>
    <button class="filter-chip" data-filter="publikation" aria-pressed="false">Publikation</button>
    <button class="filter-chip" data-filter="open-source" aria-pressed="false">Open Source</button>
    <button class="filter-chip" data-filter="preprint" aria-pressed="false">Preprint</button> -->
  </nav>
		<div class="flex flex-col flex-wrap gap-5 md:flex-row">
			{
				englishPublications.map((x) => {
					return (
						<div class="single-publication w-[90lvw] rounded-sm md:w-2/5">
							<Publication class:list={'h-full'} input={x} />
						</div>
					)
				})
			}
		</div>
	</main>
</NavSideBarLayout>
<script>
	document.addEventListener("astro:page-load", () => {
  const chips = document.querySelectorAll('.filter-chip');
  const cards = document.querySelectorAll('.card');

  chips.forEach(chip => {
    chip.addEventListener('click', () => {
      chips.forEach(c => c.setAttribute('aria-pressed', 'false'));
      chip.setAttribute('aria-pressed', 'true');

	  // @ts-ignore
      const f = chip.dataset.filter;
      cards.forEach(card => {
	  // @ts-ignore

        const show = f === 'alle' || card.dataset.tags.split(' ').includes(f);
        card.parentElement?.classList.toggle('hidden', !show);
      });
    });
  });
	});
</script>
