
---
import { getCollection } from 'astro:content';

interface Props {
  lang?: 'de' | 'en';
}

const { lang } = Astro.props;

// Sprache anhand der URL bestimmen.
// Funktioniert mit /de/... und /en/...
const pathLocale = Astro.url.pathname
  .split('/')
  .filter(Boolean)[0];

const locale = lang ?? (
  pathLocale === 'de' || pathLocale === 'en'
    ? pathLocale
    : 'en'
);

// Alle Timeline-Einträge laden
const entries = await getCollection('careers', ({ id }) =>
  id.startsWith(`${locale}/`)
);

// Chronologisch absteigend sortieren
const sortedEntries = entries.sort(
  (a, b) => {
        // Aktuelle Positionen zuerst
  const aCurrent = a.data.end === undefined;
  const bCurrent = b.data.end === undefined;

  if (aCurrent !== bCurrent) {
    return Number(bCurrent) - Number(aCurrent);
  }

  // Anschließend nach Startjahr absteigend
  return b.data.start - a.data.start;
  }

);
---

<div class="relative mt-2">

  <!-- Timeline-Linie -->
  <div
    class="absolute left-[23px] top-2 bottom-2 w-px
    bg-gradient-to-b from-[var(--accent)]
    via-[var(--line)] to-transparent"
  ></div>

  <div class="relative">

    {sortedEntries.map(({ data }) => (
      <article
        class="relative grid grid-cols-[48px_minmax(0,1fr)]
        gap-3 py-[18px] sm:gap-[22px] group"
      >
        <div
          class="relative z-10 flex h-12 w-12 items-center
          justify-center rounded-[14px]
          border border-[var(--line)]
          bg-[var(--bg-2)]
          font-[var(--font-head)] text-[15px]
          text-[var(--accent)]
          transition-colors
          group-hover:border-[var(--accent-darker)]
          group-hover:bg-[var(--accent-soft)]"
        >
          {data.shortTitle}
        </div>

        <!-- Card -->
        <div
          class="grid grid-cols-[60px_minmax(0,1fr)]
          items-start gap-3 rounded-[var(--radius)]
          border border-[var(--line)]
          bg-[var(--card)] p-4
          transition-all duration-300
          group-hover:-translate-y-0.5
          group-hover:border-[rgba(217,168,108,0.35)]
          group-hover:bg-[var(--card-2)]
          sm:grid-cols-[80px_minmax(0,1fr)]
          sm:gap-5 sm:p-[22px_26px]"
        >

          <!-- Logo -->
          <div
            class="flex  items-center
            justify-center overflow-hidden 
            career-logo
            w-10
            sm:w-20"
          >
            {data.image ? (
              <img
                src={data.image.src}
                alt={`${data.imageAlt} logo`}
                class="h-full w-full object-contain"
                loading="lazy"
                aspect-ratio={data.image.width / data.image.height}
              />
            ) : (
              <span
                class="font-[var(--font-head)]
                text-sm text-[var(--muted)]"
              >
                {data.title}
              </span>
            )}
          </div>

          <!-- Content -->
          <div class="min-w-0">

            <span
              class="mb-2 block text-[11px] font-semibold
              uppercase tracking-[0.1em]
              text-[var(--accent)] sm:text-[13px]"
            >
              {data.title}
            </span>

            <h3 class="mb-2 text-lg font-semibold">
              {data.description}
            </h3>
            {
                data.end ? (
                  <span
                    class="mb-3 inline-block rounded-full
                    border border-[rgba(138,184,172,0.25)]
                    bg-[rgba(138,184,172,0.1)]
                    px-[11px] py-[3px]
                    text-xs font-semibold text-[var(--teal)]"
                  >
                    {data.start} - {data.end}
                  </span>
                ) : (
                  <span
                    class="mb-3 inline-block rounded-full
                    border border-[rgba(217,168,108,0.25)]
                    bg-[rgba(217,168,108,0.1)]
                    px-[11px] py-[3px]
                    text-xs font-semibold text-[var(--yellow)]"
                  >
                    {data.start}
                  </span>
                )
            }

            <p
              class="text-sm leading-[1.65]
              text-[var(--muted)] sm:text-[15px]"
            >
              {data.description}
            </p>

          </div>
        </div>
      </article>
    ))}

  </div>
</div>
