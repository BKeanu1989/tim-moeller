---
import type { CollectionEntry } from 'astro:content'
import { Picture, Image } from 'astro:assets'

interface CareerEntry {
	title: string
	description: string
	start: number
	end: number
	image: string

	imageAlt: string
}

interface Props {
	input: CollectionEntry<'careers'>
}

const { input } = Astro.props

const { title, description, image, imageAlt, start, end } = input.data
---

<article class="flex w-1/4 flex-col gap-2 px-4">
	<div class="career-image-container flex items-center justify-center">
		<Picture class="" src={image} alt={imageAlt || title} />
	</div>
	<h1 class="text-2xl">{title}</h1>
	<div class="start-end">
		{end ? `${start} - ${end}` : `Since ${start}`}
	</div>
	<div>
		{description}
	</div>
</article>
