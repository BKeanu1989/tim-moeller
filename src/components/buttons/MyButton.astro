
---

type ButtonType = 'primary' | 'secondary' | 'tertiary' | 'alarm' | 'ok';

interface Props {
  type?: ButtonType;
  class?: string;
  htmlType?: 'button' | 'submit' | 'reset';
  href?: string;
  download?: boolean | string;
  disabled?: boolean;
}

const {
  type = 'primary',
  class: className = '',
  htmlType = 'button',
  href,
    download,

  disabled = false,
} = Astro.props;

const variantClasses: Record<ButtonType, string> = {
  primary: 'btn-primary button rounded bg-blue-500 px-5 py-2 text-lg text-white',
  secondary: 'btn-secondary',
  tertiary: 'btn-tertiary px-5 py-2 border mt-4 rounded-lg w-fit text-white ease-out transition hover:scale-105 hover:bg-blue-600/10',
  alarm: 'btn-alarm bg-red-800 rounded hover:bg-red-600 text-white px-5 py-2',
  ok: 'btn-ok bg-green-800 rounded hover:bg-green-600 text-white px-5 py-2'
  
};

const classes = [
  'btn',
  variantClasses[type],
  className,
].filter(Boolean).join(' ');

---

{href ? (
  <a
    class={classes}
    href={href}
    download={download}
    aria-disabled={disabled || undefined}
  >
    <slot />
  </a>
) : (
  <button
    type={htmlType}
    class={classes}
    disabled={disabled}
  >
    <slot />
  </button>
)}