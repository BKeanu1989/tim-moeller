---
import { getLangFromUrl, useTranslations } from "src/i18n/utils";
import MyButton from "./buttons/MyButton.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---
<div class="cookie-banner hidden md:block h-min fixed bottom-0 right-5 bg-slate-500 z-20" id="cookie-banner" data-status="closed">
    <!-- <button class="rounded-t-[0.25rem] text-white py-2 px-5 open-cookie-banner" data-target="cookie-button">{t('misc.cookies_button')}</button> -->
    <div class="banner relative h-min hidden py-5 justify-between border" data-target="cookie-banner" role="dialog" aria-modal="true" aria-labelledby="cookie-banner-title">
        <button
            type="button"
            id="cc-close"
            aria-label={t('cookie.close')}
            title={t('cookie.close')}
            class="absolute top-3 right-3 inline-flex items-center justify-center w-11 h-11 rounded-full text-white/80 hover:text-white hover:bg-white/10 focus:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-slate-800 transition-colors cursor-pointer"
        >
            <svg aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6">
                <path d="M18 6 6 18M6 6l12 12" />
            </svg>
        </button>
        <form action="" class="flex flex-col h-full p-5 gap-5">
            <div class="cookie-banner--text">
                <h1 id="cookie-banner-title" class="mx-auto text-3xl mb-4 text-center font- px-10">{t('cookie.title')}</h1>
                {t('cookie.text')}</div>
            <div class="checkbox-categories">
                <!-- <label for="statistics">{t('cookie.statistics')}</label>
                <input type="checkbox" name="statistics" id="statistics"> -->
                <details class="cookie-banner__details">
                <summary>{t('cookie.title')}</summary>
                <label>
                    <input type="checkbox" id="cc-necessary" checked disabled />
                    {t('cookie.necessary')}
                </label>
                <label>
                    <input type="checkbox" id="cc-statistics" />
                    <!-- Statistik &amp; Marketing (Google Tag Manager / Google Analytics) -->
                    {t('cookie.statistics')}
                </label>
                <label>
                    <input type="checkbox" id="cc-functional" />
                    <!-- Spam-Schutz (Cloudflare Turnstile) -->
                    {t('cookie.functional')}
                </label>
                </details>
            </div>
            <div class="cookie-banner--buttons mt-auto">
                <!-- <MyButton type="alarm" class="decline">{t('misc.decline')}</MyButton>
                 
                <MyButton type="ok" class="accept">{t('misc.accept')}</MyButton> -->
                <MyButton htmlType="button" type="primary" id="cc-accept-all"> {t('cookie.accept_all')}</MyButton>
                    <MyButton htmlType="button" type="tertiary" id="cc-save">
                        {t('cookie.save')}
                    </MyButton>
                    <MyButton htmlType="button" type="tertiary" id="cc-reject">
                        {t('cookie.only_necessary')}
                    </MyButton>
            </div>
        </form>
    </div>
</div>
<script>
    // import 
    import {CookieBannerObserver} from "../scripts/cookiebanner"
    // import CookieBannerMoeller from "../scripts/cookieBannerv3"
    let cookieWrapper: HTMLElement | null  
    let cookieBanner: HTMLElement  | null
    let cookieButton: HTMLElement | null

    let cookieWrapperFn = () => document.querySelector("div.cookie-banner") as HTMLElement
    let cookieBannerFn = () => document.querySelector(".cookie-banner div[data-target='cookie-banner']") as HTMLElement
    let cookieButtonFn = () => document.querySelector(".cookie-banner [data-target='cookie-button']") as HTMLElement

        
    
    let statisticsInput = document.getElementById('cc-statistics') as HTMLInputElement
    let functionalInput = document.getElementById('cc-functional') as HTMLInputElement
    let foo: any;


    
    let isOpening = false;
    let lastFocused: HTMLElement | null = null;
    
    // console.log("included cookiebannermodule", CookieBannerMoeller)
    // if (!CookieBannerMoeller) {
    //     if (!window.CookieBannerMoeller) {
            
    //         window.CookieBannerMoeller = CookieBannerMoeller.instance;
    //     }
    // }
    
    function initCookieBanner() {

        // window.Complianz.
        // let cookieWrapperFn = () => document.querySelector("div.cookie-banner") as HTMLElement
        // let cookieBannerFn = () => document.querySelector(".cookie-banner div[data-target='cookie-banner']") as HTMLElement
        // let cookieButtonFn = () => document.querySelector(".cookie-banner [data-target='cookie-button']") as HTMLElement
        cookieWrapper = cookieWrapperFn()
        cookieBanner = cookieBannerFn()
        cookieButton = cookieButtonFn()


        cookieButtonFn()?.addEventListener('click', (e) => {
            const event = new CustomEvent('open-banner')
            window.dispatchEvent(event)
        })

        document.getElementById('cc-close')?.addEventListener('click', () => {
            emitCloseBanner()
        })

        document.addEventListener('keydown', (event) => {
            if (event.key === 'Escape' && cookieWrapperFn()?.dataset.status === 'open') {
                emitCloseBanner()
            }
        })
    
        document.addEventListener('click', (event) => {
            cookieWrapper = cookieWrapperFn()

            if (cookieWrapper && cookieWrapper.dataset.status === 'open') {
                const withinBoundaries = event.composedPath().includes(cookieWrapper)
        
                if (!withinBoundaries && !isOpening) {
                    emitCloseBanner()
                } 
            }
        })
    
        window.addEventListener('close-banner', (e) => {
            try {
                cookieBanner = cookieBannerFn()
                cookieButton = cookieButtonFn()
                cookieWrapper = cookieWrapperFn()

                cookieBanner?.classList.add('hidden')
                cookieButton?.classList.remove('hidden')
                if (cookieWrapper) {
                    cookieWrapper.dataset.status = "closed"
                }

                // return focus to the element that opened the banner (a11y)
                lastFocused?.focus?.()
                lastFocused = null

            } catch (error) {
                console.error(error)
            }
        })
    
        window.addEventListener('open-banner', (e) => {
            try {
                isOpening = true;
                cookieBanner = cookieBannerFn()
                cookieButton = cookieButtonFn()
                cookieWrapper = cookieWrapperFn()

                cookieBanner?.classList.remove('hidden')  
                cookieButton?.classList.add('hidden')
                if (cookieWrapper) {
                    cookieWrapper.dataset.status = "open"
                    cookieWrapper.classList.remove('hidden')
                }

                // move keyboard focus into the dialog (a11y)
                lastFocused = document.activeElement as HTMLElement | null
                requestAnimationFrame(() => document.getElementById('cc-close')?.focus())


                let perms = window.CookieBannerMoeller.getConsent()
                // console.log(perms)

                if (perms) {
                    if (perms.statistics) {
                        statisticsInput.checked = true;
                    }
                    if (perms.functional) {
                        functionalInput.checked = true
                    }
                }  

                setTimeout(() => {
                    isOpening = false;
                }, 150)
            } catch (error) {
                console.error(error)
            }
        })



        // foo = new CookieBannerObserver();
        // window.Complianz.attach(foo)

        // // if (window.Complianz.getAnswered() == false) {
        // //     const event = new CustomEvent('open-banner')
        // //     window.dispatchEvent(event)
        // // }

        // if (window.Complianz.getStatistics() == true) {
        //     statisticsInput.checked = true
        // }

    }

    initCookieBanner()
    document.addEventListener('astro:page-load', initCookieBanner);

    document.addEventListener("astro:before-swap", () => {
        window.Complianz.detach(foo)
        foo = null;
    })

    function emitCloseBanner() {
        const event = new CustomEvent('close-banner')
        window.dispatchEvent(event)
    }

</script>
<style>

    button[data-target="cookie-button"] {
        background: var(--card-bg);
        backdrop-filter: blur(16px);

        /* border: 1px solid var(--border);
        border-radius: var(--radius); */

        /* box-shadow:
            0 10px 30px rgba(0, 0, 0, 0.6),
            inset 0 1px 0 rgba(255, 255, 255, 0.05); */


            
        color: var(--text);
    }
    
    .cookie-banner[data-status="open"] {
        left: calc(50% + (18rem / 2)); /* 18rem for sidebar divided by 2 for left an right */ 
        top: 50%;
        transform: translate(-50%, -50%);

        min-width: 320px;
    }
    
    @media screen and (max-width: 1023px) {
        .cookie-banner[data-status="open"] {
            left: 50%;
        }
    }
    
    .cookie-banner {
        --bg-dark: #0b0f14;
        --card-bg: rgba(255, 255, 255, 0.04);
        --border: rgba(255, 255, 255, 0.12);
        --text: rgba(255, 255, 255, 0.85);
        --muted: rgba(255, 255, 255, 0.5);
        /* --accent: #3b82f6; */

        --radius: 14px;


        position: fixed;
        /* bottom: 32px;
        left: 50%;
        transform: translateX(-50%);

        width: 420px;
        max-width: calc(100% - 32px);

        padding: 20px 22px; */

        background: var(--card-bg);
        backdrop-filter: blur(16px);

        /* border: 1px solid var(--border);
        border-radius: var(--radius); */

        box-shadow:
            0 10px 30px rgba(0, 0, 0, 0.6),
            inset 0 1px 0 rgba(255, 255, 255, 0.05);

        color: var(--text);
        
    }

    .cookie-banner::before {
        content: "";
        position: absolute;
        inset: -40px;
        z-index: -1;

        background: radial-gradient(
            circle at center,
            rgba(59, 130, 246, 0.15),
            transparent 70%
        );

        filter: blur(200px);
    }

      .cookie-banner__details { flex: 1 1 100%; }
  .cookie-banner__details label {
    display: block;
    margin: 0.4rem 0;
    cursor: pointer;
  }
</style>