---
import { languages } from '../i18n/ui'

import { getLangFromUrl, useTranslations } from 'src/i18n/utils'

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)
---

<ul class="flex flex-row place-content-center gap-2 text-slate-50">
	{
		Object.entries(languages).map(([lang, label]) => (
			<li class="flex border-solid border hover:scale-110 ease-out transition rounded-md border-white">
				<a href={`/${lang}/`} class="rounded-md p-2 hover:bg-blue-600/10 single-language-picker" data-language={lang} aria-label={lang === 'en' ? 'Link to english version' : 'Link zur deutschen Version'}>
					{lang}
					{/* {lang === 'en' ? <FlagGb /> : <FlagDe />} */}
				</a>
			</li>
		))
	}
</ul>

<script>
	document.addEventListener("astro:page-load", () => {
		const languagePickers = document.querySelectorAll('.single-language-picker')
		if (!languagePickers) return;
		languagePickers.forEach((single) => {
			single.addEventListener('click', (e) => {
				// @ts-ignore
				const targetLang: string = e.target?.dataset?.language 
				if (!targetLang ) {
					console.warn("target not foundn")
					return;
				}
				e.preventDefault()
				window.location.href = redirectToSamePageAnotherLanguage(targetLang)
			} )
		})
	})


function redirectToSamePageAnotherLanguage(lang: string) {
    const langs = ["de", "en"]
    let url = window.location.href
    langs.forEach((x) => {
        url = url.replace(`/${x}`, `/` +lang)
    })
    
    return url
    
}
</script>