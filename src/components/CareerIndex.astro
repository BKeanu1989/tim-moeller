---
import { getCollection } from 'astro:content'
import CareerElement from './CareerElement.astro'
import { Image } from 'astro:assets'

const { lang } = Astro.props
const allCareers = await getCollection('careers')

interface Props {
	lang: string
}

// const langCareers = allCareers.filter((x) => x.data.lang == `${lang}`)
const langCareers = allCareers.filter((x) => {
	return x.data.lang == `${lang}`
})
---

<div class="career-container">
	<h1 class="my-5 text-3xl">Affiliations and Contributions</h1>
	<div class="grid gap-4 md:grid-cols-4">
		<!-- <div class="flex flex-wrap gap-y-4"> -->
		{
			langCareers.map(
				(career) =>
					career && (
						// <article>
						// 	<Image src={career.data.image} alt={career.data.imageAlt} />
						// 	<h2>{career.data.title}</h2>
						// </article>
						<CareerElement class:list={'abc'} input={career} />
					)
			)
		}
	</div>
</div>
