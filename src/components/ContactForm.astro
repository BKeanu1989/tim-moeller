---


import { getLangFromUrl, useTranslations } from "src/i18n/utils";
import TertiaryButton from "./buttons/TertiaryButton.astro";
import MyButton from "./buttons/MyButton.astro";
const { class: className, ...rest } = Astro.props;
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const baseURLPrefix = (import.meta.env.DEV) ? "http://localhost:8000" : '' 
---

<!-- <form action="/mail.php" method="POST" class={className} {...rest}> -->
<form action={baseURLPrefix + "/mail.php"} method="POST" class={className} {...rest}>
  <slot />
  <div class="form-group flex flex-col gap-1">
    <label class="text-white w-1/4" for="name">{t("contact.name")}</label>
    <input
      class="h-8 rounded-sm p-1"
      type="text"
      id="name"
      placeholder="Jane Doe"
      name="name"
    />
  </div>
  <div class="form-group mt-4 flex flex-col gap-1">
    <label class="text-white" for="email">{t("contact.email")}</label>
    <input
      class="h-8 rounded-sm p-1"
      type="email"
      id="email"
      placeholder="your@email.com"
      name="email"
    />
  </div>
  <div class="form-group mt-4 flex flex-col gap-1">
    <label class="text-white" for="subject">{t("contact.subject")}</label>
    <input
      class="h-8 rounded-sm p-1"
      type="text"
      id="text"
      placeholder={t("contact.subject")}
      name="subject"
    />
  </div>
  <div class="form-group mt-4 flex flex-col gap-1">
    <label class="text-white" for="subject">{t("contact.message")}</label>
    <!-- <input type="text" id="message" placeholder="your message" name="message" /> -->
    <textarea
      id="message"
      name="message"
      class="text-black h-16 rounded-sm p-1"
      placeholder={t("contact.message.placeholder")}
    ></textarea>
  </div>
  <div class="mt-4 cf-turnstile" data-sitekey={siteKey} data-theme="dark" 
    data-callback="onSuccess"
		data-error-callback="onError"
		data-expired-callback="onExpired"
		data-timeout-callback="onTimeout"></div>

    <!-- <TertiaryButton>
    </TertiaryButton> -->
    <MyButton type="tertiary" htmlType="submit">
      
      {t("contact.send")} 
    </MyButton>
  <span class="email-status fade-out text-white" data-email-success={t('contact.email_sent')} data-email-error={t('contact.email_error')} ></span>
  <span class="hidden text-red-800" id="cmplz-status" data-cmplz-error={t('misc.complianz_error_message')}></span>
  <span class="hidden" id="hidden-info" data-url-prefix={baseURLPrefix}></span>
</form>
<script>
import { CookieBannerObserver } from "src/scripts/cookiebanner"

  const urlPrefix = document.getElementById("hidden-info")?.dataset.urlPrefix ?? ''
  let $cmplSt: HTMLElement | null
  let $submitButton: HTMLButtonElement | null 

  let $form = document.querySelector('form')
  if ($form) {

    
    $form.addEventListener('submit', (e) => {
      e.preventDefault();
      if (!window.Complianz.getStatistics()) {
        window.Complianz.openCookieBanner()
        return;
      }

      let $emailStatus = document.querySelector("span.email-status")
      try {
        let formData = new FormData($form);

        if (!$emailStatus) return
        $emailStatus.classList.remove('fade-out')
        $emailStatus.classList.remove('text-green-700')
        $emailStatus.classList.remove('text-red-700')
  
        // fetch('/mail.php', {
          
        fetch(`${urlPrefix}/mail.php`, {
          method: 'POST',
          body: formData
        })
        .then(response => {
          return response.text()
          // return response.json()
        })
        .then(data => {
          try {
            data = JSON.parse(data)
            //@ts-ignore
            if (data.success) {
            //@ts-ignore
              $emailStatus.innerHTML = $emailStatus.dataset.emailSuccess
              $emailStatus.classList.add('text-green-700')
            } else {
            //@ts-ignore
  
              $emailStatus.innerHTML = $emailStatus.dataset.emailError            
              $emailStatus.classList.add('text-red-700')
  
            }
            $form.reset()
          } catch (error) {
            console.log(error)            
          }
        });
        setTimeout(() => {
          $emailStatus?.classList.add('fade-out') 
        }, 5000)
      } catch (error) {
        console.error(error)
      } 
    })

  }

  let bar: any;


  
  function checkStatistics() {
    // reset
    $cmplSt?.classList.add("hidden")
    $submitButton?.removeAttribute("disabled")


    let statisticsPermission = window.Complianz.getStatistics()
    if (statisticsPermission) {
      // console.info("statistics perm")
    } else {
      if ($cmplSt) {
        $cmplSt.classList.remove("hidden")
        // @ts-ignore
        $cmplSt.innerHTML = $cmplSt.dataset.cmplzError
        $submitButton?.setAttribute("disabled", "true")
      }
    }

  }

  let intervalInc: any = null;
  let timeout: any;
  document.addEventListener("astro:page-load", () => {
    bar = new CookieBannerObserver();
    window.Complianz.attach(bar)
    $cmplSt = document.getElementById("cmplz-status")
    $submitButton = document.querySelector("button[type='submit'")
    intervalInc = setInterval(() => {
      checkStatistics()
    }, 2500);

    setTimeout(() => {
      let statisticPerm = window.Complianz.getStatistics();
      if (!statisticPerm) {
        window.Complianz.openCookieBanner();
      }
      
    }, 1500);
  })

  document.addEventListener("astro:before-swap", () => {
    clearInterval(intervalInc)
    window.Complianz.detach(bar)
    bar = null;

    clearTimeout(timeout)
  })


</script>

<style>
  .c-mx-auto {
    margin: 0 auto;
  }

@keyframes fadeOut {
  from { opacity: 1; }
  to { opacity: 0; }
}

.fade-out {
  animation: fadeOut 3s ease-in-out forwards;
}
</style>
