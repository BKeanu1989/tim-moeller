        let formData = new FormData($form);

        if (!$emailStatus) return
        $emailStatus.classList.remove('fade-out')
        $emailStatus.classList.remove('text-green-700')
        $emailStatus.classList.remove('text-red-700');
  
        
        (async function() {
          try {
            let response = await fetch(`/api/verify.php`, {
              method: 'POST',
              credentials: 'include',
              body: formData
            })
            let data = await response.json()
            console.log(data)
            if (data.success) {
              // $form.reset()
            } else {
              removeCaptchaInput()
              console.log("end submit and remove captcha input")
              return
            }
            
          } catch (error) {
            console.log(error)
          }
          console.log("verified")
          try {
            let response = await fetch(`/api/mail.php`, {
              method: 'POST',
              credentials: 'include',
              body: formData
            })
            let data = await response.json()
            console.log(data)
            if (data.success) {
              // $form.reset()
              // @ts-ignore
              $emailStatus.innerHTML = $emailStatus.dataset.emailSuccess
              $emailStatus.classList.add('text-green-700')
            } else {
              // removeCaptchaInput()
              // console.log("end submit and remove captcha input")
              // return

            // @ts-ignore
            $emailStatus.innerHTML = $emailStatus.dataset.emailError            
            $emailStatus.classList.add('text-red-700')
            }
          } catch (error) {
            console.log(error)
          }

        })()
        

        // fetch().then((res) => res.json()).then((data) => {
        //   console.log("response", data)
        // }).catch(err => console.error).then(() => {
        //   fetch(`/api/mail.php`, {
        //     method: 'POST',
        //     credentials: 'include',
        //     body: formData
        //   }).then((res) => {
        //     console.log("api call")
        //     return res.json()}
        //   ).then((data) => {
        //     console.log(data)
        //   }).catch(err => console.error)
        //   .finally(() => {
        //     $form.reset()
        //   })
        // })

        // fetch('/mail.php', {
        // fetch(`${api_url}mail.php`, {
        //   method: 'POST',
        //   credentials: 'include',
        //   body: formData
        // })
        // .then(response => {
  
        //   // console.log(response)
        //   return response.text()
        //   // return response.json()
        // })
        // .then(data => {
        //   data = JSON.parse(data)
        //   //@ts-ignore
        //   if (data.success) {
        //   //@ts-ignore
        //     $emailStatus.innerHTML = $emailStatus.dataset.emailSuccess
        //     $emailStatus.classList.add('text-green-700')
        //   } else {
        //   //@ts-ignore

        //     $emailStatus.innerHTML = $emailStatus.dataset.emailError            
        //     $emailStatus.classList.add('text-red-700')

        //   }
        //   $form.reset()
        // });
        setTimeout(() => {
          $emailStatus?.classList.add('fade-out') 
        }, 5000)
      } catch (error) {
        console.error(error)
      } 
    })

  }

let removeCaptchaInput = () => {
  let ele = document.querySelector("#captcha_image") as HTMLInputElement
  if (ele) {
    ele.value = ""
  }
} 

function randomNumber() {
  return Math.random()*1000
}

function refreshCaptcha() {
  console.log("refresh captcha")
  let rand = randomNumber();
  fetch(`/api/captcha.php?rand=${rand}`, {
    credentials: 'include',
    method: "GET",
  }).then(res => res.json()).catch((err) => console.log(err)).then((data) => {
    console.log(data)

    if (data.image) {
      let captchaImage = document.querySelector("#captcha_image") as HTMLImageElement
      if (!captchaImage) {
        console.error("captcha image not found")
      }
      captchaImage.src = `data:image/jpeg;base64,${data.image}`
    }
  })  

    // @ts-ignore
    // var img = document.images['captcha_image'];
    // img.src = img.src.substring(
		// 0,img.src.lastIndexOf("?")
		// )+"?rand="+randomNumber();

}

// @ts-ignore
function toggle(e) {
  console.log("toggle", e)
}

(function() {
  refreshCaptcha()

  try {
    let button = document.querySelector(".toggle")
    let buttonResponseHolder = document.querySelector(".button-response-holder")
    if (button && buttonResponseHolder) {
      button.addEventListener("click", (e) => {
        console.log(e)
        buttonResponseHolder.innerHTML = ""
        buttonResponseHolder.innerHTML = "<iframe src='http://0.0.0.0:8080/verify.php' />"

      })
    }
  } catch (error) {
    console.error(error)
  }

  try {
    let button = document.querySelector(".anker-reload-captcha")
    if (button) {
      button.addEventListener("click", (e) => {
        console.log(e)
        refreshCaptcha()
      })
    }
  } catch (error) {
    console.error(error)
  }
})()
</script>

<style>
  .c-mx-auto {
    margin: 0 auto;
  }

@keyframes fadeOut {
  from { opacity: 1; }
  to { opacity: 0; }
}

.fade-out {
  animation: fadeOut 3s ease-in-out forwards;
}
</style>
