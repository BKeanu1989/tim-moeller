---
/**
 * ProjectPage.astro — Landingpage / Einzelseite für ein Projekt.
 *
 * Nutzung (z. B. src/pages/projekt.astro):
 *
 *   ---
 *   import ProjectPage from '../components/ProjectPage.astro';
 *   const content = `
 *     <p>Einleitung …</p>
 *     <p>Die Kostenfunktion $L = \frac{1}{n}\sum (y_i - \hat{y}_i)^2$
 *     minimieren wir über $$ \theta^* = \arg\min_\theta L(\theta). $$</p>
 *   `;
 *   ---
 *   <ProjectPage
 *     title="Mein Projekt"
 *     subtitle="Optionaler Untertitel"
 *     author="Max Mustermann"
 *     authorRole="Entwickler"
 *     date={new Date('2026-11-12')}
 *     minutesRead={8}
 *     image={import('../assets/hero.jpg')}   <!-- oder ein URL-String, optional -->
 *     content={content}
 *   />
 *
 * `content` ist ein HTML-String und darf LaTeX enthalten:
 *   inline  -> $...$
 *   display -> $$...$$ (eigene Zeile)
 */
interface Props {
  title: string;
  subtitle?: string;
  author: string;
  authorRole?: string;
  date?: Date;
  minutesRead?: number;
  /** Pfad/URL oder ImageMetadata (Astro-Asset). Wenn weggelassen: Farbfläche. */
  image?: string | { src: string };
  imageAlt?: string;
  badge?: string;
  /** HTML mit optional eingebettetem LaTeX */
  content: string;
  /** LaTeX-Rendering über KaTeX (default: true) */
  latex?: boolean;
}

const {
  title,
  subtitle,
  author,
  authorRole,
  date,
  minutesRead,
  image,
  imageAlt = '',
  badge = 'Projekt',
  content,
  latex = true,
} = Astro.props;

const imgSrc = image ? (typeof image === 'string' ? image : image.src) : null;
const initials = author
  .split(/\s+/)
  .map((w) => w[0])
  .slice(0, 2)
  .join('')
  .toUpperCase();
const formattedDate = date
  ? new Intl.DateTimeFormat('de-DE', { day: 'numeric', month: 'long', year: 'numeric' }).format(date)
  : null;
---

{latex && (
  <>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css" />
    <script is:inline defer src="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.js"></script>
    <script is:inline defer src="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/contrib/auto-render.min.js"></script>
    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => {
        if (window.renderMathInElement) {
          window.renderMathInElement(document.querySelector('.prose') || document.body, {
            delimiters: [
              { left: '$$', right: '$$', display: true },
              { left: '$',  right: '$',  display: false },
            ],
            throwOnError: false,
          });
        }
      });
    </script>
  </>
)}

<article class="project-page">
  <header class:list={['hero', { 'hero--image': imgSrc }]}>
    {imgSrc && (
      <>
        <img class="hero-img" src={imgSrc} alt={imageAlt} loading="eager" />
        <div class="hero-scrim" aria-hidden="true"></div>
      </>
    )}
    <div class="hero-inner">
      <span class="badge">{badge}</span>
      <h1 class="title">{title}</h1>
      {subtitle && <p class="subtitle">{subtitle}</p>}

      <div class="byline">
        <span class="avatar" aria-hidden="true">{initials}</span>
        <div class="byline-text">
          <span class="author">{author}</span>
          {(authorRole || formattedDate || minutesRead) && (
            <span class="meta">
              {[
                authorRole,
                formattedDate,
                minutesRead ? `${minutesRead} Min. Lesezeit` : null,
              ].filter(Boolean).join(' · ')}
            </span>
          )}
        </div>
      </div>
    </div>
  </header>

  <div class="prose" set:html={content} />

  <footer class="author-card">
    <span class="avatar avatar--lg" aria-hidden="true">{initials}</span>
    <div>
      <span class="author-card-label">Autor:in</span>
      <span class="author-card-name">{author}</span>
      {authorRole && <span class="author-card-role">{authorRole}</span>}
    </div>
  </footer>
</article>

<style>
  .project-page {
    background: var(--bg);
    color: var(--text);
    font-family: var(--font-body);
    min-height: 100vh;
  }

  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    overflow: hidden;
    padding: clamp(4rem, 12vw, 8rem) 1.5rem clamp(3rem, 8vw, 5.5rem);
    background:
      radial-gradient(60rem 30rem at 50% -10rem, var(--accent-soft), transparent 70%),
      linear-gradient(180deg, var(--bg-2), var(--bg));
  }
  .hero--image { background: var(--bg); }

  .hero-img {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover;
  }
  .hero-scrim {
    position: absolute; inset: 0;
    background: linear-gradient(180deg, rgba(11,15,20,.55), rgba(11,15,20,.82) 65%, var(--bg));
  }

  .hero-inner {
    position: relative; z-index: 1;
    max-width: 46rem;
    margin-inline: auto;
    text-align: center;
  }

  .badge {
    display: inline-block;
    font-size: .75rem;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--accent);
    background: var(--accent-soft);
    border: 1px solid rgba(217, 168, 108, .35);
    border-radius: 999px;
    padding: .3rem .9rem;
    margin-bottom: 1.25rem;
  }

  .title {
    font-family: var(--font-head);
    font-weight: 600;
    font-size: clamp(2.25rem, 6vw, 3.75rem);
    line-height: 1.08;
    letter-spacing: -0.015em;
    margin: 0 0 1rem;
  }

  .subtitle {
    font-size: clamp(1.05rem, 2.5vw, 1.3rem);
    color: var(--muted-light);
    line-height: 1.6;
    margin: 0 auto 2.25rem;
    max-width: 40rem;
  }

  .byline {
    display: flex; align-items: center; justify-content: center; gap: .85rem;
  }
  .avatar {
    display: grid; place-items: center;
    width: 2.75rem; height: 2.75rem;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--accent-lighter), var(--accent-darker));
    color: #14100a;
    font-weight: 700; font-size: .95rem;
    flex-shrink: 0;
  }
  .byline-text { text-align: left; }
  .author { display: block; font-weight: 600; font-size: .95rem; }
  .meta { display: block; color: var(--muted); font-size: .85rem; margin-top: .15rem; }

  /* ---------- Fließtext / LaTeX ---------- */
  .prose {
    max-width: 42rem;
    margin-inline: auto;
    padding: clamp(2.5rem, 7vw, 4.5rem) 1.5rem 0;
    font-size: 1.075rem;
    line-height: 1.8;
    color: var(--muted-light);
  }
  .prose > *:first-child { margin-top: 0; }
  .prose p { margin: 0 0 1.4em; }
  .prose h2, .prose h3, .prose h4 {
    font-family: var(--font-head);
    color: var(--text);
    line-height: 1.25;
    margin: 2.2em 0 .8em;
  }
  .prose h2 { font-size: 1.65rem; }
  .prose h3 { font-size: 1.3rem; }
  .prose a { color: var(--accent); text-decoration: underline; text-decoration-color: rgba(217,168,108,.4); text-underline-offset: 3px; }
  .prose a:hover { color: var(--accent-lighter); text-decoration-color: currentColor; }
  .prose strong { color: var(--text); }
  .prose ul, .prose ol { padding-left: 1.4em; margin: 0 0 1.4em; }
  .prose li { margin-bottom: .4em; }
  .prose blockquote {
    margin: 1.8em 0;
    padding: .4em 0 .4em 1.3em;
    border-left: 3px solid var(--accent);
    color: var(--muted);
    font-style: italic;
  }
  .prose code {
    font-family: ui-monospace, 'Cascadia Code', Menlo, Consolas, monospace;
    font-size: .875em;
    background: var(--card-2);
    border: 1px solid var(--line);
    border-radius: .35em;
    padding: .15em .4em;
    color: var(--teal);
  }
  .prose pre {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: .8rem;
    padding: 1.1rem 1.25rem;
    overflow-x: auto;
    margin: 0 0 1.6em;
  }
  .prose pre code { background: none; border: 0; padding: 0; color: var(--text); }
  .prose img { border-radius: .8rem; border: 1px solid var(--line); }
  .prose hr { border: 0; border-top: 1px solid var(--line); margin: 2.5em 0; }

  /* KaTeX farblich einbinden */
  .prose .katex { font-size: 1.05em; color: var(--text); }
  .prose .katex-display {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: .8rem;
    padding: 1rem 1.25rem;
    margin: 1.8em 0;
    overflow-x: auto;
  }

  /* ---------- Autor-Fußzeile ---------- */
  .author-card {
    max-width: 42rem;
    margin: clamp(3rem, 8vw, 5rem) auto 0;
    padding: 0 1.5rem clamp(4rem, 10vw, 6rem);
    display: flex; align-items: center; gap: 1rem;
  }
  .author-card > div { display: flex; flex-direction: column; }
  .avatar--lg { width: 3.25rem; height: 3.25rem; font-size: 1.1rem; }
  .author-card-label {
    font-size: .72rem; letter-spacing: .14em; text-transform: uppercase;
    color: var(--accent); margin-bottom: .2rem;
  }
  .author-card-name { font-family: var(--font-head); font-size: 1.2rem; color: var(--text); }
  .author-card-role { color: var(--muted); font-size: .9rem; margin-top: .1rem; }
</style>